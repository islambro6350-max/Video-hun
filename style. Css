/* 🌐 Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background: #0d0d0d;
    color: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 🧭 Header */
header {
    background: #1a1a2e;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    border-bottom: 2px solid #e94560;
}

header h1 {
    color: #e94560;
    font-size: 1.8rem;
}

nav a, nav button {
    color: #fff;
    background: transparent;
    border: none;
    margin-left: 15px;
    text-decoration: none;
    font-size: 1rem;
    cursor: pointer;
    padding: 8px 15px;
    border-radius: 5px;
    transition: 0.3s;
}

nav a:hover, nav button:hover {
    background: #e94560;
    color: #fff;
}

/* 📦 Main Container */
main {
    flex: 1;
    max-width: 1200px;
    margin: 20px auto;
    padding: 0 20px;
    width: 100%;
}

/* 🎬 Video Grid */
.video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
    margin-top: 20px;
}

.video-card {
    background: #1a1a2e;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
    border: 1px solid #2a2a4a;
}

.video-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(233, 69, 96, 0.3);
}

.video-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    cursor: pointer;
}

.video-card .content {
    padding: 15px;
}

.video-card h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
    color: #fff;
}

.video-card p {
    color: #aaa;
    font-size: 0.9rem;
    margin-bottom: 12px;
}

.video-card .watch-btn {
    display: inline-block;
    background: #e94560;
    color: #fff;
    padding: 10px 20px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: center;
}

.video-card .watch-btn:hover {
    background: #c73652;
    transform: scale(1.02);
}

/* 📝 Admin Forms */
form {
    background: #1a1a2e;
    padding: 25px;
    border-radius: 12px;
    max-width: 600px;
    margin: 20px auto;
    border: 1px solid #2a2a4a;
}

form input, form textarea {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    background: #0d0d0d;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    color: #fff;
    font-size: 1rem;
}

form input:focus, form textarea:focus {
    outline: none;
    border-color: #e94560;
}

form button {
    width: 100%;
    padding: 12px;
    background: #e94560;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    margin-top: 10px;
}

form button:hover {
    background: #c73652;
}

/* 🗑️ Admin Action Buttons */
.admin-actions {
    display: flex;
    gap: 10px;
    margin-top: 10px;
}

.admin-actions button {
    flex: 1;
    padding: 8px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.edit-btn {
    background: #ffc107;
    color: #000;
}

.edit-btn:hover {
    background: #e0a800;
}

.delete-btn {
    background: #dc3545;
    color: #fff;
}

.delete-btn:hover {
    background: #b02a37;
}

/* 🔐 Login Page */
#loginForm {
    max-width: 400px;
    margin: 40px auto;
}

#loginMessage {
    text-align: center;
    margin-top: 15px;
    color: #ffc107;
}

/* 📱 Mobile Responsive */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        text-align: center;
        gap: 10px;
    }
    nav a, nav button {
        margin: 0 8px;
    }
    .video-grid {
        grid-template-columns: 1fr;
    }
}

/* 🛠️ Loading & Messages */
.loading {
    text-align: center;
    padding: 40px;
    color: #aaa;
}

.error {
    color: #dc3545;
    text-align: center;
    padding: 20px;
}

.success {
    color: #28a745;
    text-align: center;
    padding: 20px;
}
